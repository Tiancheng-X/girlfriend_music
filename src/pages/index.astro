---
// 重写（v3，AMLL 沉浸式）：整页即播放体验——页头 + 沉浸式大播放器（AMLL 歌词主舞台），
// 流体渐变背景由 MiniPlayer 挂载的 AMLL canvas 提供，铺满全页。
import Base from "@/layouts/Base.astro";
import BigPlayer from "@/components/BigPlayer.astro";
---

<Base title="宝宝的歌单">
	<main class="page">
		<h1 class="page__title">宝宝的歌单</h1>

		<BigPlayer />
	</main>
</Base>

<style>
	.page {
		position: relative;
		z-index: 1;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		width: 100%;
		max-width: 1320px;
		margin: 0 auto;
		padding: clamp(0.75rem, 2.5vw, 1.5rem) clamp(1rem, 4vw, 2.5rem) 0;
		min-height: 100svh;
	}

	.page__title {
		margin: 0 0 clamp(0.5rem, 2vw, 1rem);
		font-size: clamp(1.25rem, 3vw, 1.75rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
		text-align: center;
	}
</style>
