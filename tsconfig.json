{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"strict": true,
		"noImplicitAny": true,
		"verbatimModuleSyntax": true,
		"allowJs": false,
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"src/*"
			]
		},
		"types": [
			"astro/client"
		]
	},
	"include": [
		".astro/types.d.ts",
		"**/*"
	],
	"exclude": [
		"dist",
		"node_modules"
	]
}
