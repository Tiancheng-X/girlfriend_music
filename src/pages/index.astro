---
// 重写：首页即整站 —— 大播放器（布局 A）占主位，全局 mini-player + 正在播放 sheet 由 Base 挂载。
import Base from "@/layouts/Base.astro";
import BigPlayer from "@/components/BigPlayer.astro";
---

<Base title="宝宝的歌单">
	<main class="page">
		<h1 class="page__title">宝宝的歌单</h1>

		<BigPlayer />
	</main>
</Base>

<style>
	.page {
		position: relative;
		z-index: 1;
		box-sizing: border-box;
		width: 100%;
		max-width: 68rem;
		margin: 0 auto;
		padding: clamp(1.25rem, 5vw, 2.5rem) clamp(1rem, 4vw, 2rem) 0;
	}

	.page__title {
		margin: 0 0 clamp(1rem, 3vw, 1.75rem);
		font-size: clamp(1.5rem, 4vw, 2.25rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
		text-align: center;
	}
</style>
