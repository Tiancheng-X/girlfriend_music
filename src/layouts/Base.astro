---
// 重写：Apple Music 风暗色主题根布局（票据 03 tokens 定稿）。
// 播放引擎 MusicManager 挂载单例；MiniPlayer 挂载氛围背景 + mini-player + 正在播放 sheet。
import MusicManager from "@/components/MusicManager.astro";
import MiniPlayer from "@/components/MiniPlayer.astro";
import "@/styles/player.css";

interface Props {
	title?: string;
}

const { title = "宝宝的歌单" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#101013" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<!-- 播放引擎单例：暴露 window.__fireflyMusic，供控制器驱动 -->
		<MusicManager />
		<!-- 全局播放器外壳：氛围背景 + mini-player + 正在播放 sheet -->
		<MiniPlayer />
	</body>
</html>

<style is:global>
	/* ── 设计 tokens（票据 03 定稿：无彩深灰底 + #fa2d48 强调） ── */
	:root {
		--am-bg: #101013;
		--am-surface: #1a1a1f;
		--am-accent: #fa2d48;
		--am-text: oklch(0.98 0 0);
		--am-text-2: oklch(0.7 0 0);
		--am-text-3: oklch(0.55 0 0);
		--am-line: rgba(255, 255, 255, 0.12);
		--am-mat: rgba(24, 24, 28, 0.55); /* L1 玻璃基色：mini / sheet */
		--am-mat-heavy: rgba(18, 18, 21, 0.78); /* sheet 体色 */
		--am-shadow: 0 18px 48px rgba(0, 0, 0, 0.5);

		color-scheme: dark;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		min-height: 100%;
	}

	body {
		background: var(--am-bg);
		color: var(--am-text);
		font-family:
			-apple-system,
			"SF Pro Text",
			system-ui,
			"PingFang SC",
			"MiSans",
			"Microsoft YaHei",
			sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	/* sheet 打开时锁页面滚动 */
	body.np-lock {
		overflow: hidden;
	}

	.is-hidden {
		display: none !important;
	}

	/* sheet 内滚动条细化 */
	.custom-scrollbar {
		scrollbar-width: thin;
		scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
	}

	.custom-scrollbar::-webkit-scrollbar {
		width: 6px;
	}

	.custom-scrollbar::-webkit-scrollbar-track {
		background: transparent;
	}

	.custom-scrollbar::-webkit-scrollbar-thumb {
		background: rgba(255, 255, 255, 0.2);
		border-radius: 3px;
	}
</style>
