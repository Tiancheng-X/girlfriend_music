---
// 重写（v3，AMLL 沉浸式）：AMLL 流体背景挂载点（CSS 光晕作降级）、
// 底部 mini-player、全屏队列 sheet（歌词已归主页面，sheet 只承载队列与快捷控制）。
import Icon from "@/components/Icon.astro";
import { t } from "@/i18n/zh";
import "@/styles/player.css";
---

<!-- AMLL 流体渐变背景（MeshGradientRenderer），WebGL 失败时由下方 CSS 光晕兜底 -->
<div class="amll-bg" data-amll-bg aria-hidden="true"></div>
<div class="np-ambient" data-ambient-a aria-hidden="true"></div>
<div class="np-ambient" data-ambient-b aria-hidden="true"></div>

<!-- mini-player：常驻底部，轻点或上拉展开队列 sheet -->
<div class="mini-player" data-mini-player aria-label="迷你播放器">
	<div class="mini-cover">
		<img data-mini-img alt="" width="44" height="44" decoding="async" />
	</div>
	<div class="mini-text">
		<span class="mini-name" data-mini-name>{t("musicNoPlaying")}</span>
		<span class="mini-artist" data-mini-artist></span>
	</div>
	<span class="mini-eq" data-eq aria-hidden="true"><i></i><i></i><i></i></span>
	<button class="mini-btn" type="button" data-mini-play aria-label={t("musicPlay")}>
		<Icon name="material-symbols:play-arrow-rounded" class="icon-play" />
		<Icon name="material-symbols:pause-rounded" class="icon-pause is-hidden" />
	</button>
	<span class="mini-grip" aria-hidden="true"><Icon name="mdi:chevron-up" /></span>
</div>

<!-- 队列 sheet：下拖或收起按钮关闭 -->
<div class="np-scrim" data-scrim aria-hidden="true"></div>
<section class="np-sheet" data-np-sheet role="dialog" aria-modal="true" aria-label={t("musicQueue")} data-closed>
	<div class="np-grab" aria-hidden="true"><span></span></div>
	<header class="np-head">
		<span class="np-cap">{t("musicPlaylist")}</span>
		<button class="np-close" type="button" data-sheet-close aria-label={t("npCollapse")}>
			<Icon name="mdi:chevron-down" />
		</button>
	</header>
	<div class="np-body">
		<div class="np-progress-row">
			<span class="np-time" data-np-time-current>0:00</span>
			<div class="np-slider" data-np-progress-slider></div>
			<span class="np-time np-time-total" data-np-time-total>-0:00</span>
		</div>

		<div class="np-transport">
			<button class="np-btn" type="button" data-np-mode aria-label={t("playModeList")}>
				<Icon name="material-symbols:repeat-rounded" class="icon-mode-list" />
				<Icon name="material-symbols:repeat-one-rounded" class="icon-mode-one is-hidden" />
				<Icon name="material-symbols:shuffle-rounded" class="icon-mode-shuffle is-hidden" />
			</button>
			<button class="np-btn" type="button" data-np-prev aria-label={t("musicPrev")}>
				<Icon name="material-symbols:skip-previous-rounded" />
			</button>
			<button class="np-btn np-play" type="button" data-np-play aria-label={t("musicPlay")}>
				<Icon name="material-symbols:play-arrow-rounded" class="icon-play" />
				<Icon name="material-symbols:pause-rounded" class="icon-pause is-hidden" />
			</button>
			<button class="np-btn" type="button" data-np-next aria-label={t("musicNext")}>
				<Icon name="material-symbols:skip-next-rounded" />
			</button>
		</div>

		<div class="np-volume">
			<button class="np-btn" type="button" data-np-mute aria-label={t("musicVolume")} aria-pressed="false">
				<Icon name="material-symbols:volume-up-rounded" class="icon-vol-on" />
				<Icon name="material-symbols:volume-off-rounded" class="icon-vol-off is-hidden" />
			</button>
			<div class="np-vol-slider" data-np-volume-slider></div>
		</div>

		<div
			class="np-playlist custom-scrollbar"
			role="listbox"
			aria-label={t("musicPlaylist")}
			aria-busy="true"
			data-playlist-list
		>
			<div class="np-skeleton" aria-hidden="true">
				<span class="np-skeleton-row"></span>
				<span class="np-skeleton-row"></span>
				<span class="np-skeleton-row"></span>
				<span class="np-skeleton-row"></span>
				<span class="np-skeleton-row"></span>
				<span class="np-skeleton-row"></span>
			</div>
		</div>
	</div>
</section>

<!-- 设置 sheet：下拖或收起按钮关闭，分组表单即时生效 -->
<div class="np-scrim" data-settings-scrim aria-hidden="true"></div>
<section class="np-sheet" data-settings-sheet role="dialog" aria-modal="true" aria-label={t("settingsTitle")} data-closed>
	<div class="np-grab" aria-hidden="true"><span></span></div>
	<header class="np-head">
		<span class="np-cap">{t("settingsTitle")}</span>
		<button class="np-close" type="button" data-settings-close aria-label={t("npCollapse")}>
			<Icon name="mdi:chevron-down" />
		</button>
	</header>
	<div class="np-body">
		<section class="set-group">
			<h3 class="set-group-title">{t("setGroupPlayback")}</h3>
			<div class="set-row">
				<div class="set-label">
					{t("setPlayModeLabel")}
					<span class="set-desc">{t("setPlayModeDesc")}</span>
				</div>
				<div class="set-segmented" role="radiogroup" aria-label={t("setPlayModeLabel")} data-set-playmode>
					<button class="set-seg" type="button" role="radio" data-value="0">{t("playModeList")}</button>
					<button class="set-seg" type="button" role="radio" data-value="1">{t("playModeSingle")}</button>
					<button class="set-seg" type="button" role="radio" data-value="2">{t("playModeShuffle")}</button>
				</div>
			</div>
		</section>

		<section class="set-group">
			<h3 class="set-group-title">{t("setGroupDisplay")}</h3>
			<div class="set-row">
				<div class="set-label">{t("setLyricScaleLabel")}</div>
				<div class="set-segmented" role="radiogroup" aria-label={t("setLyricScaleLabel")} data-set-lyricscale>
					<button class="set-seg" type="button" role="radio" data-value="0.85">{t("setLyricSmall")}</button>
					<button class="set-seg" type="button" role="radio" data-value="1">{t("setLyricStandard")}</button>
					<button class="set-seg" type="button" role="radio" data-value="1.2">{t("setLyricLarge")}</button>
				</div>
			</div>
			<div class="set-row">
				<div class="set-label">
					{t("setBgLabel")}
					<span class="set-desc">{t("setBgDesc")}</span>
				</div>
				<button class="set-switch" type="button" role="switch" aria-checked="true" data-set-bgenabled>
					<span class="set-knob"></span>
				</button>
			</div>
			<div class="set-row">
				<div class="set-label">
					{t("setMotionLabel")}
					<span class="set-desc">{t("setMotionDesc")}</span>
				</div>
				<button class="set-switch" type="button" role="switch" aria-checked="false" data-set-motionreduced>
					<span class="set-knob"></span>
				</button>
			</div>
		</section>

		<section class="set-group">
			<h3 class="set-group-title">{t("setGroupData")}</h3>
			<div class="set-row">
				<div class="set-label">
					{t("setClearLabel")}
					<span class="set-desc">{t("setClearDesc")}</span>
				</div>
				<button class="set-danger" type="button" data-set-clear>{t("setClearAction")}</button>
			</div>
		</section>

		<section class="set-group">
			<h3 class="set-group-title">{t("setGroupAbout")}</h3>
			<p class="set-about">
				{t("setAboutLine1")}
				<br />
				{t("setAboutLine2")}
			</p>
		</section>
	</div>
</section>

<!-- 歌单条目结构：控制器按批克隆填充 -->
<template data-playlist-template>
	<button class="np-item" type="button" role="option">
		<span class="np-item-index"></span>
		<img class="np-item-cover" alt="" loading="lazy" decoding="async" width="40" height="40" />
		<span class="np-item-text">
			<span class="np-item-name"></span>
			<span class="np-item-artist"></span>
		</span>
	</button>
</template>

<script>
	import { setupSheet } from "@/utils/sheet-controller";
	import { setupSettingsSheet } from "@/utils/settings-controller";

	// 单页站点，模块脚本只执行一次；data 标记兜底防重复挂载
	const sheet = document.querySelector<HTMLElement>("[data-np-sheet]");
	if (sheet && sheet.dataset.ready !== "true") {
		sheet.dataset.ready = "true";
		setupSheet();
	}
	const settingsSheet = document.querySelector<HTMLElement>("[data-settings-sheet]");
	if (settingsSheet && settingsSheet.dataset.ready !== "true") {
		settingsSheet.dataset.ready = "true";
		setupSettingsSheet();
	}
</script>
