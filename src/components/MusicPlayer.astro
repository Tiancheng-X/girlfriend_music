---
import Icon from "@/components/Icon.astro";
import { t } from "@/i18n/zh";

/**
 * 桌面端可拖拽音乐组件（Swup 容器外持久存在）。
 * 三态：disc 收起唱片 → pill 播放中胶囊（唱片 + 歌词） → bar 展开 dock；
 * dock 上方只有一张展开卡：信息层（曲名 / 艺术家 / 进度）常驻，点歌单按钮时
 * 同一张卡向上长出歌单 / 歌词面板，信息层随之上移，不再是两张分离的卡片。
 * 引擎为 MusicManager 单例，逻辑见 src/utils/music-player-controller.ts，
 * 样式见 src/styles/components/music-player.css。移动端（≤768px）隐藏，由 MobileDock 承担。
 */
---

<div
	class="music-player music-player-widget"
	data-state="disc"
	data-panel="closed"
	data-playing="false"
	role="region"
	aria-label={t("music")}
>
	<div class="music-player__stage">
		<!-- 展开卡：面板与信息层共用一张表面 -->
		<div class="music-player__card">
			<div class="music-player__panel">
				<div class="music-player__panel-clip">
					<div class="music-player__panel-body">
						<div class="music-player__panel-tabs">
							<span class="music-player__tab-indicator" aria-hidden="true"></span>
							<button class="music-player__tab music-player__tab--playlist is-active" type="button">{t("musicPlaylist")}</button>
							<button class="music-player__tab music-player__tab--lyrics" type="button">{t("musicLyrics")}</button>
						</div>
						<div class="music-player__panel-views">
							<div class="music-player__playlist-view is-active">
								<div class="music-player__playlist-list custom-scrollbar" role="listbox" aria-label={t("musicPlaylist")}></div>
							</div>
							<div class="music-player__lyrics-view">
								<div class="music-player__lyrics-list custom-scrollbar" role="listbox" aria-label={t("musicLyrics")}>
									<div class="music-player__lyrics-placeholder">{t("musicNoLyrics")}</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- 信息层：bar 态常驻在展开卡底部，唱片骑在其左下角 -->
			<div class="music-player__info">
				<div class="music-player__info-clip">
					<div class="music-player__info-surface">
						<p class="music-player__title">{t("musicNoPlaying")}</p>
						<p class="music-player__artist"></p>
						<div class="music-player__progress-row">
							<span class="music-player__time-current">0:00</span>
							<div
								class="music-player__progress"
								role="slider"
								aria-label={t("musicProgress")}
								aria-valuemin="0"
								aria-valuemax="100"
								aria-valuenow="0"
							>
								<div class="music-player__progress-bar"></div>
								<div class="music-player__progress-thumb"></div>
							</div>
							<span class="music-player__time-total">0:00</span>
						</div>
						<!-- 加载指示只占信息层，不再给整个组件蒙一层遮罩 -->
						<div class="music-player__loading" aria-hidden="true">
							<Icon name="material-symbols:sync-rounded" class="mp-icon-xl" aria-hidden="true" />
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- 工具栏层：胶囊歌词槽与工具栏共用同一槽位交叉淡入 -->
		<div class="music-player__bar">
			<div class="music-player__slot">
				<span class="music-player__pill-text"><span class="music-player__pill-label"></span></span>
				<div class="music-player__toolbar">
					<button class="music-player__btn music-player__btn--mode" data-tooltip={t("playModeList")} aria-label={t("playModeList")} type="button">
						<Icon name="material-symbols:repeat-rounded" class="music-player__icon-mode-list mp-icon-lg" aria-hidden="true" />
						<Icon name="material-symbols:repeat-one-rounded" class="music-player__icon-mode-one mp-icon-lg is-hidden" aria-hidden="true" />
						<Icon name="material-symbols:shuffle-rounded" class="music-player__icon-mode-shuffle mp-icon-lg is-hidden" aria-hidden="true" />
					</button>
					<button class="music-player__btn music-player__btn--lyrics" data-tooltip={t("musicLyrics")} aria-label={t("musicLyrics")} aria-pressed="true" type="button">
						<Icon name="material-symbols:subtitles-outline-rounded" class="music-player__icon-lrc-on mp-icon-lg" aria-hidden="true" />
						<Icon name="material-symbols:subtitles-off-outline-rounded" class="music-player__icon-lrc-off mp-icon-lg is-hidden" aria-hidden="true" />
					</button>
					<button class="music-player__btn music-player__btn--prev" data-tooltip={t("musicPrev")} aria-label={t("musicPrev")} type="button">
						<Icon name="material-symbols:skip-previous-rounded" class="mp-icon-xl" aria-hidden="true" />
					</button>
					<button class="music-player__btn music-player__btn--play" data-tooltip={t("musicPlay")} aria-label={t("musicPlay")} type="button">
						<Icon name="material-symbols:play-arrow-rounded" class="music-player__icon-play mp-icon-2xl" aria-hidden="true" />
						<Icon name="material-symbols:pause-rounded" class="music-player__icon-pause mp-icon-2xl is-hidden" aria-hidden="true" />
					</button>
					<button class="music-player__btn music-player__btn--next" data-tooltip={t("musicNext")} aria-label={t("musicNext")} type="button">
						<Icon name="material-symbols:skip-next-rounded" class="mp-icon-xl" aria-hidden="true" />
					</button>
					<button class="music-player__btn music-player__btn--playlist" data-tooltip={t("musicPlaylist")} aria-label={t("musicPlaylist")} type="button">
						<Icon name="mdi:playlist-music" class="mp-icon-lg" aria-hidden="true" />
					</button>
					<div class="music-player__volume">
						<button class="music-player__btn music-player__btn--volume" data-tooltip={t("musicVolume")} aria-label={t("musicVolume")} type="button">
							<Icon name="material-symbols:volume-up-rounded" class="music-player__icon-vol-on mp-icon-lg" aria-hidden="true" />
							<Icon name="material-symbols:volume-off-rounded" class="music-player__icon-vol-off mp-icon-lg is-hidden" aria-hidden="true" />
						</button>
						<div class="music-player__volume-pop">
							<Icon name="material-symbols:volume-down-rounded" class="music-player__volume-icon music-player__volume-icon--start mp-icon-md" aria-hidden="true" />
							<div
								class="music-player__volume-track"
								role="slider"
								aria-label={t("musicVolume")}
								aria-orientation="horizontal"
								aria-valuemin="0"
								aria-valuemax="100"
								aria-valuenow="70"
							>
								<div class="music-player__volume-bar"></div>
								<div class="music-player__volume-thumb"></div>
								<span class="music-player__volume-bubble" aria-hidden="true">70%</span>
							</div>
							<Icon name="material-symbols:volume-up-rounded" class="music-player__volume-icon music-player__volume-icon--end mp-icon-md" aria-hidden="true" />
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- 唱片：三态复用的圆碟，位置随形态过渡 -->
		<button class="music-player__disc" type="button" aria-label={t("music")}>
			<Icon name="material-symbols:music-note-rounded" class="music-player__disc-placeholder mp-icon-xl" aria-hidden="true" />
			<img class="music-player__disc-img is-empty" src="" alt="" draggable="false" />
		</button>
	</div>

	<!-- 尺寸探针：控制器据此读取 --mp-width / --mp-bar-h / --mp-disc-rise 的实际像素值，
	     用于按当前形态夹取拖拽位置（根元素宽高在过渡中，量不到目标值） -->
	<span class="music-player__probe" aria-hidden="true">
		<span class="music-player__probe-bar"></span>
		<span class="music-player__probe-rise"></span>
	</span>
</div>

<template id="music-player-item-template">
	<div class="music-player__track" role="option">
		<div class="music-player__track-cover-wrap">
			<img src="" class="music-player__track-cover" loading="lazy" alt="" />
			<div class="music-player__track-active is-hidden">
				<Icon name="material-symbols:graphic-eq-rounded" class="mp-icon-sm" aria-hidden="true" />
			</div>
		</div>
		<div class="music-player__track-meta">
			<div class="music-player__track-title"></div>
			<div class="music-player__track-artist"></div>
		</div>
	</div>
</template>

<script>
	import { setupMusicPlayerWidget } from "@/utils/music-player-controller";

	// 原实现用 Swup 的 definePersistentIsland 保证整个文档生命周期只初始化一次；
	// 本站没有客户端路由，模块脚本本身只执行一次，再用 data 标记兜底防止重复挂载。
	const root = document.querySelector<HTMLElement>(".music-player-widget");
	if (root && root.dataset.mpReady !== "true") {
		root.dataset.mpReady = "true";
		setupMusicPlayerWidget();
	}
</script>
